- content_for :title do
  = @source.title
  |  | Gregobase

h1
  | Gregobase:
  em=< @source.title
  |  chants

= link_to 'Back to Sources', gregobase_sources_path

= paginate @chants

ul
  - @chants.each do |chant|
    - already_imported = @imported_ids.include? chant.id
    - relevant_genre = @relevant_genres.include? chant['office-part']
    li
      span.gregobase-genre(
        class=(already_imported ? 'gregobase-already-imported' : (relevant_genre ? 'gregobase-unimported-relevant-genre' : nil))
        title=(already_imported ? 'already imported' : nil)
      )= chant['office-part']
      =< chant.incipit
      =< link_to "[Gregobase]", GregobaseUri.chant_uri(chant.id), class: 'small'
      - if chant.remarks
        br
        em= chant.remarks
      br
      = image_tag GregobaseUri.chant_image_uri(chant.id), loading: 'lazy'

= paginate @chants
